{
  "name": "last-call",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "TableRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableRoom"] }]
}
